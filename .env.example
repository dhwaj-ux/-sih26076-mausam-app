# ---------------------------------------------------------------------------
# MAUSAM AI - environment configuration
# Copy this file to `.env` and fill in what you have.
#   cp .env.example .env
# The app runs fine with EVERYTHING blank (offline knowledge base mode).
# ---------------------------------------------------------------------------

# Port the Express server listens on
PORT=3000

# --- Weather data -----------------------------------------------------------
# Open-Meteo is completely free and needs NO key. Leave these as they are.
OPEN_METEO_FORECAST=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_MARINE=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_GEOCODE=https://geocoding-api.open-meteo.com/v1/search

# --- AI provider (optional) -------------------------------------------------
# Which LLM to use for live answers: gemini | groq | openrouter
# Leave blank to always use the built-in offline knowledge base.
LLM_PROVIDER=

# Google Gemini - free tier, no credit card -> https://aistudio.google.com
GEMINI_API_KEY=

# Groq - free tier, very fast -> https://console.groq.com
GROQ_API_KEY=

# OpenRouter - free models -> https://openrouter.ai
OPENROUTER_API_KEY=

# Model overrides (sensible defaults are built in)
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Server behaviour -------------------------------------------------------
# Seconds to cache upstream weather responses in memory
CACHE_TTL_SECONDS=600
