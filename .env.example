# =============================================================================
# SIH26076 Mausam App — Environment Variables Template
# Copy this file to backend/.env and fill in your real API keys.
# =============================================================================

PORT=3000

# OpenWeatherMap API Key (free tier at https://openweathermap.org/api)
OWM_KEY=acc52ef2a61718231f018dcb9e4c13ec

# Optional: Stormglass API Key (marine data, https://stormglass.io/)
# STORMGLASS_KEY=your_stormglass_key_here

# Optional: OpenRouteService or Mapbox API Key (traffic/routing data)
# ORS_KEY=your_openrouteservice_key_here
# MAPBOX_KEY=your_mapbox_key_here

# Optional: MongoDB Connection String (for saving user locations)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mausam
