{
  "name": "mausam-ai",
  "version": "1.0.0",
  "private": true,
  "description": "MAUSAM AI — personalised weather homepage with persona-based AI advisory (SIH26076, MoES / IMD)",
  "main": "server/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build:standalone": "node scripts/build-standalone.js",
    "proof": "node test/proof.js",
    "test": "node test/run-tests.js",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:open": "cap open android"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  },
  "keywords": [
    "sih",
    "sih26076",
    "mausam",
    "imd",
    "weather",
    "aqi",
    "monsoon",
    "hackathon"
  ],
  "license": "MIT"
}
